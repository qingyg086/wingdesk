{
  "_note": "政策 Agent 回答的自动检查规则。这些规则是在看过 2026-11-08 首轮回答之后写的，用于回归检查（同一批题修改前后对比），不是盲测。关键词判断只能发现明显问题，通过不代表回答完全正确，仍需人工抽查。",
  "global": {"require_retrieval": true, "citations_must_exist": true},
  "cases": {
    "R01": {"behavior": "answer", "must_include_any": [["3 件", "3件", "三件"]]},
    "R02": {"behavior": "answer", "must_include_any": [["1 件随身", "1件随身", "一件随身", "随身行李 1", "1 件"], ["个人物品"]]},
    "R08": {"behavior": "answer", "must_include_any": [["差价"]], "must_not_include": ["航班号"]},
    "R20": {"behavior": "answer", "must_include_any": [["直飞", "不接受中转", "不允许中转", "不能转机", "不可转机", "不接受转机"]]},
    "R25": {"behavior": "answer", "must_include_any": [["订票用户", "订票人", "订票会员"], ["1 件", "1件", "一件"]]},
    "R30": {"behavior": "answer", "must_include_any": [["申报"], ["2 块", "2块", "两块"]]},
    "R37": {"behavior": "unknown", "must_include_any": [["没有", "未", "无法确认", "不能确认"]],
            "must_not_include": ["禁止使用", "不得使用", "严禁", "民航局", "可以正常使用"]},
    "R38": {"behavior": "unknown", "must_include_any": [["没有", "未", "无法确认", "不能确认"]],
            "must_not_regex": ["每公斤\\s*\\d", "\\d+\\s*美元\\s*/\\s*公斤"]},
    "R39": {"behavior": "unknown", "must_include_any": [["没有", "未", "无法确认", "不能确认"]],
            "must_not_regex": ["\\d+\\s*(美元|元)\\s*/\\s*小时", "每小时\\s*\\d"]},
    "R40": {"behavior": "unknown", "must_include_any": [["无法查询", "不能查询", "无法查看", "查询订单", "不属于政策", "不在政策", "无法确认", "无法实时"]]},
    "R41": {"behavior": "unknown", "must_include_any": [["没有", "未", "无法", "不提供", "不属于"]],
            "must_not_include": ["eTA", "TRV", "电子旅行授权", "访客签证"]},
    "R42": {"behavior": "unknown", "must_include_any": [["没有", "未", "无法确认", "不能确认"]],
            "must_not_regex": ["\\d+\\s*积分"]},
    "R43": {"behavior": "unknown", "must_include_any": [["没有", "未", "无法确认", "不能确认"]],
            "must_not_include": ["禁止使用电子烟", "不得", "严禁", "民航局"]},
    "R44": {"behavior": "unknown", "must_include_any": [["没有", "未", "无法确认", "不能确认"]],
            "must_not_regex": ["汇率\\s*(为|是|约)?\\s*[:：]?\\s*\\d", "\\d+(\\.\\d+)?\\s*元人民币"]},
    "R45": {"behavior": "clarify", "must_include_any": [["随身", "托运"]],
            "must_not_include": ["超级经济舱", "公务舱", "头等舱", "航班号"]},
    "R46": {"behavior": "clarify", "must_include_any": [["订单", "下单", "舱位", "保险", "原因"]],
            "must_not_include": ["购票渠道"]},
    "R47": {"behavior": "clarify", "must_include_any": [["延误", "取消", "行李"]],
            "must_not_regex": ["\\d+\\s*美元"]},
    "R48": {"behavior": "clarify", "must_include_any": [["什么物品", "哪件物品", "哪种物品", "哪个物品", "具体是什么", "什么东西", "哪一件", "哪类"]]}
  }
}

# 阿里云百炼 API Key (必需，用于 LLM 和 Embedding)
DASHSCOPE_API_KEY=your-dashscope-api-key

# Redis 配置 (用于短期记忆，可选)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=1800

# Milvus 配置 (用于长期记忆，可选)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_API_KEY=

# Neo4j 配置 (用于知识图谱，可选)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# 日志级别
LOG_LEVEL=INFO


# MySQL 配置 (MCP 工具查询订单/实例/监控)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=airline

# 系统时钟：fixed = 固定为 2024-05-15 15:00（美东时间，与原始数据一致，测试和评测总是用它）；
# live = 真实当前时间，配合 python agent/database/demo_data.py rebase 平移后的演示数据使用
WINGDESK_CLOCK=live
